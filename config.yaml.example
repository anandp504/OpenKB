# model: gpt-5.4                          # OpenAI
# model: anthropic/claude-sonnet-4-6      # Anthropic
# model: gemini/gemini-3.1-pro-preview    # Google Gemini
# model: minimax/MiniMax-M2.1             # MiniMax
# model: ollama/llama3.2                  # Ollama (local)
model: gpt-5.4                            # LLM model (any LiteLLM-supported provider)
language: en                     # Wiki output language
pageindex_threshold: 20          # PDF pages threshold for PageIndex
max_concurrency: 1               # Max concurrent LLM calls per document (raise for cloud APIs)
batch_concurrency: 1             # Max documents compiled in parallel (raise for cloud APIs)
